  const quizLevelButtons = document.querySelectorAll('.quiz-level-btn');

  quizLevelButtons.forEach(button => {
    button.addEventListener('click', () => {
      quizLevelButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');
      currentQuizLevel = `level${button.dataset.level}`;
      startQuiz(currentQuizLevel);
    });
  });

  function startQuiz(level) {
    currentQuizLevel = level;
    currentQuestionIndex = 0;
    quizResult.textContent = '';
    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-disabled', 'true');
    submitBtn.style.display = 'block'; // Ensure button is visible
    quizTimerDisplay.textContent = ''; // Clear timer
    clearInterval(timerInterval); // Clear any existing timer
    showQuizQuestion();
  }

  function showQuizQuestion() {
    const questions = quizData[currentQuizLevel];
    if (!questions) {
      questionText.textContent = "Por favor, selecciona un nivel de quiz para empezar.";
      quizOptions.innerHTML = '';
      submitBtn.style.display = 'none';
      quizProgressBar.style.width = "0%";
      quizTimerDisplay.textContent = '';
      clearInterval(timerInterval);
      return;
    }

    if (currentQuestionIndex >= questions.length) {
      questionText.textContent = `¡Felicidades! Terminaste el Nivel ${currentQuizLevel.replace('level','')} 🎉 ¡Eres un campeón ambiental!`;
      quizOptions.innerHTML = "";
      submitBtn.style.display = 'none';
      quizResult.textContent = '';
      quizProgressBar.style.width = "100%";
      quizTimerDisplay.textContent = '';
      clearInterval(timerInterval);
      return;
    }

    const currentQ = questions[currentQuestionIndex];
    questionText.textContent = currentQ.question;
    quizOptions.innerHTML = '';
    currentQ.options.forEach((option, index) => {
      const li = document.createElement('li');
      li.innerHTML = `<label tabindex="0"><input type="radio" name="option" value="${index}"><span>${option}</span></label>`;
      quizOptions.appendChild(li);
    });
    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-disabled', 'true');

    const radios = quizOptions.querySelectorAll('input[name="option"]');
    radios.forEach(radio => {
      radio.addEventListener('change', () => {
        submitBtn.disabled = false;
        submitBtn.setAttribute('aria-disabled', 'false');
      });
    });

    quizResult.textContent = '';
    updateProgressBar();
    startTimer();
  }

  function startTimer() {
    clearInterval(timerInterval);
    let timeLeft = timerDuration;
    quizTimerDisplay.textContent = `Tiempo restante: ${timeLeft}s`;
    timerInterval = setInterval(() => {
      timeLeft--;
      quizTimerDisplay.textContent = `Tiempo restante: ${timeLeft}s`;
      if (timeLeft <= 0) {
        clearInterval(timerInterval);
        quizResult.style.color = "#c0392b";
        quizResult.textContent = "¡Tiempo agotado! Inténtalo de nuevo.";
        currentQuestionIndex++; // Move to next question
        setTimeout(() => {
          quizResult.textContent = '';
          showQuizQuestion();
        }, 1500); // Wait briefly before showing next question
      }
    }, 1000);
  }

  submitBtn.addEventListener('click', () => {
    clearInterval(timerInterval); // Stop timer on submission
    const selectedOption = quizOptions.querySelector('input[name="option"]:checked');
    const questions = quizData[currentQuizLevel];

    if (!selectedOption) {
      quizResult.style.color = "#c0392b";
      quizResult.textContent = "Por favor, selecciona una opción.";
      startTimer(); // Restart timer if no option selected
      return;
    }

    const selectedIndex = parseInt(selectedOption.value, 10);

    if (selectedIndex === questions[currentQuestionIndex].answer) {
      quizResult.style.color = "#27ae60";
      quizResult.textContent = "¡Correcto! ¡Excelente respuesta! 😊";
    } else {
      quizResult.style.color = "#c0392b";
      quizResult.textContent = "Incorrecto. La respuesta correcta era: " + questions[currentQuestionIndex].options[questions[currentQuestionIndex].answer] + ".";
    }
    currentQuestionIndex++;
    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-disabled', 'true');

    updateProgressBar();

    setTimeout(() => {
      quizResult.textContent = '';
      showQuizQuestion();
    }, 2600);
  });

  function resetQuiz() {
    clearInterval(timerInterval);
    currentQuestionIndex = 0;
    quizResult.textContent = '';
    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-disabled', 'true');
    submitBtn.style.display = 'block';
    questionText.textContent = 'Selecciona un nivel para jugar.';
    quizOptions.innerHTML = '';
    quizProgressBar.style.width = "0%";
    quizTimerDisplay.textContent = '';
    quizLevelButtons.forEach(btn => btn.classList.remove('active'));
    currentQuizLevel = null;
  }

  function updateProgressBar() {
    const total = quizData[currentQuizLevel]?.length || 1;
    const progressPercent = (currentQuestionIndex / total) * 100;
    quizProgressBar.style.width = progressPercent + "%";
  }

